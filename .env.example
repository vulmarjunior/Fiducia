# GROQ_API_KEY: Configure somente no ambiente server-side da Vercel.
# Nunca use prefixo VITE_ e nunca exponha esta chave no cliente.
# Get your key at: https://console.groq.com
GROQ_API_KEY="MY_GROQ_API_KEY"

# Conta Google autorizada a usar o proxy de IA (uso pessoal/proprietário único).
FIDUCIA_OWNER_EMAIL="owner@example.com"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
